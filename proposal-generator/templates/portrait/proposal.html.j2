{%- set s = p.system -%}
{%- set f = p.financial -%}
{%- set co = p.get('company', {}) -%}
{%- set titles = {
  'overview': ('01 · Overview', 'Proposal Overview'),
  'engineering': ('02 · Design & Engineering', 'Designed for Your Site'),
  'ongrid': ('03 · On-Grid Solution', 'Seamless, Flicker-Free Solar'),
  'energy': ('04 · Energy & Bill Impact', 'Your PLN Bill With Solar'),
  'roi': ('05 · Financial Analysis', 'Return on Investment'),
  'savings': ('05 · Financial Analysis', '25-Year Savings Projection'),
  'quotation': ('06 · Investment', 'Quotation'),
  'scope': ('07 · Scope of Work', 'What HME Delivers'),
  'boq': ('08 · Bill of Quantity', 'Bill of Quantity'),
  'warranty': ('09 · Warranty & Schedule', 'Warranty & Project Timeline'),
  'datasheet': ('Appendix · Datasheet', ''),
} -%}
{%- macro pageno(kind) -%}{% for k, d in pages %}{% if k == kind %}{{ '%02d' % loop.index }}{% endif %}{% endfor %}{%- endmacro -%}
{%- set has_scr = fin.scr < 0.995 -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ p.meta.number }} · {{ p.client.name }}</title>
<link rel="stylesheet" href="{{ root }}/templates/proposal.css">
</head>
<body>
{% for kind, d in pages %}
{% set n = loop.index %}
{% if kind == 'cover' %}
<section class="page cover">
  <svg class="deco" viewBox="0 0 400 400" fill="none" stroke="#F59A1B" stroke-opacity=".35" stroke-width="1.2">
    <polygon points="250,10 330,56 330,148 250,194 170,148 170,56"/>
    <polygon points="340,170 390,199 390,257 340,286 290,257 290,199"/>
    <polygon points="120,250 160,273 160,319 120,342 80,319 80,273"/>
  </svg>
  <div class="brand"><img src="{{ root }}/assets/img/hme-logo.png" alt=""><div><b>PT Hexa Multi Energi</b><span>Clean energy for a better future</span></div></div>

  <div class="hexes">
    <div class="hex-ring" style="left:22mm;top:0;width:58mm;height:67mm"></div>
    <div class="hex" style="left:23mm;top:1.15mm;width:56mm;height:64.7mm;background-image:url('{{ root }}/assets/img/photo-rooftop.png')"></div>
    <div class="hex" style="left:0;top:52mm;width:44mm;height:50.8mm;background-image:url('{{ root }}/assets/img/photo-floating.png')"></div>
    <div class="hex" style="left:47mm;top:62mm;width:44mm;height:50.8mm;background-image:url('{{ root }}/assets/img/photo-ground.png')"></div>
  </div>

  <div class="title">
    <div class="eyebrow">Solar PV System Proposal</div>
    <h1><em>{{ s.capacity_kwp|num }} kWp</em><br>{{ s.type }} {{ s.mounting }}<br>Solar Power Plant</h1>
    <div class="for">Prepared for</div>
    <div class="client">{{ p.client.name }}</div>
    <div class="loc">{{ p.client.location }}, Indonesia</div>
  </div>

  <div class="kpis">
    <div><b>{{ s.capacity_kwp|num }} kWp</b><span>Installed capacity</span></div>
    {% if fin.load %}<div><b>{{ (fin.load.solar_share*100)|num }}%</b><span>Of your electricity from solar</span></div>{% else %}<div><b>{{ (fin.y1_energy/1000)|num }} MWh</b><span>Production in year 1</span></div>{% endif %}
    <div><b>{{ fin.payback|num(1) }} years</b><span>Payback period</span></div>
    <div><b>{{ fin.co2_y1|num }} t</b><span>CO₂ avoided per year</span></div>
  </div>

  <div class="meta">
    <div><span>Quotation no.</span><b>{{ p.meta.number }}</b></div>
    <div><span>Date</span><b>{{ p.meta.date }}</b></div>
    <div><span>Revision</span><b>{{ p.meta.revision }}</b></div>
    <div><span>Prepared by</span><b>{{ p.meta.prepared_by }}</b></div>
  </div>
  <div class="foot"><span>www.hexamultienergi.com · admin@hexamultienergi.com</span><span>Citraland, Surabaya · +62 31 743 7168</span></div>
</section>
{% else %}
<section class="page inner {{ kind }}">
  <header class="ph">
    <div>
      <div class="eyebrow">{{ titles[kind][0] }}</div>
      <h1>{% if kind == 'datasheet' %}{{ d.title }}{% elif kind == 'boq' and d.part > 0 %}Bill of Quantity (cont.){% else %}{{ titles[kind][1] }}{% endif %}</h1>
    </div>
    <img class="logo" src="{{ root }}/assets/img/hme-logo.png" alt="HME">
  </header>
  <div class="ph-rule"></div>
  <main class="pc">

{% if kind == 'overview' %}
    <p class="lead">PT Hexa Multi Energi (“HME”) is pleased to submit this proposal for the engineering, procurement and construction (EPC) of a <span class="hl">{{ s.capacity_kwp|num }} kWp {{ s.type|lower }} {{ s.mounting|lower }} solar PV system</span> for {{ p.client.name }} in {{ p.client.location }}.</p>
    <p>Solar lets {{ p.client.name }} lower its long-term electricity cost, reduce its dependence on rising utility tariffs, and take greater responsibility for sustainable energy. PV is a durable, proven technology that powers manufacturing facilities all over the world.</p>

    <div class="grid g2 mt" style="grid-template-columns: 1.15fr 1fr; gap: 7mm">
      <div>
        <h2>Project summary</h2>
        <table class="kv">
          <tr><td>Customer</td><td>{{ p.client.name }}</td></tr>
          <tr><td>Location</td><td>{{ p.client.location }}</td></tr>
          <tr><td>Market segment</td><td>{{ p.client.segment }}</td></tr>
          <tr><td>System type</td><td>{{ s.type }} · {{ s.mounting }}</td></tr>
          <tr><td>PV capacity</td><td>{{ s.capacity_kwp|num }} kWp / {{ s.capacity_kva|num }} kVA</td></tr>
          <tr><td>DC/AC ratio</td><td>{{ (s.capacity_kwp / s.capacity_kva)|num(2) }}</td></tr>
          {% if s.battery %}<tr><td>Battery</td><td>{{ s.battery }}</td></tr>{% endif %}
          <tr><td>Specific yield</td><td>{{ fin.specific_yield|num }} kWh/kWp/year ({{ f.peak_sun_hours|num(1) }} h/day)</td></tr>
          <tr><td>Production, year 1</td><td>{{ fin.y1_energy|num }} kWh</td></tr>
          <tr><td>Production, {{ f.years }} years</td><td>{{ (fin.total_energy/1000)|num }} MWh</td></tr>
        </table>
      </div>
      <div>
        <h2>Main components</h2>
        <div class="card mb"><div class="comp"><div class="n">{{ s.panel.qty }}×</div><div class="t"><b>{{ s.panel.brand }} {{ s.panel.model }}</b><span>{{ s.panel.wp }} Wp module · Tier-1</span></div></div></div>
        <div class="card mb"><div class="comp"><div class="n">{{ s.inverter.qty }}×</div><div class="t"><b>{{ s.inverter.brand }} {{ s.inverter.model }}</b><span>{{ s.inverter.kva }} kVA string inverter</span></div></div></div>
        <div class="card mb"><div class="comp"><div class="n">24/7</div><div class="t"><b>Monitoring</b><span>{{ s.monitoring }}</span></div></div></div>
        <div class="kpi dark"><div class="v">{{ fin.co2_total|num }} <small>t CO₂</small></div><div class="l">Emissions avoided over {{ f.years }} years ({{ fin.co2_y1|num }} t per year, grid factor {{ f.grid_emission_factor_t_mwh|num(2) }} t/MWh)</div></div>
      </div>
    </div>

    <h2 class="mt">In this proposal</h2>
    <div class="grid g3 toc-grid">
      <div><b>Design &amp; engineering</b><span>{{ pageno('engineering') }}</span></div>
      <div><b>On-grid solution &amp; monitoring</b><span>{{ pageno('ongrid') }}</span></div>
      {% if fin.load %}<div><b>PLN bill impact</b><span>{{ pageno('energy') }}</span></div>{% endif %}
      <div><b>Return on investment</b><span>{{ pageno('roi') }}</span></div>
      <div><b>Quotation &amp; terms</b><span>{{ pageno('quotation') }}</span></div>
      <div><b>Scope &amp; bill of quantity</b><span>{{ pageno('scope') }}</span></div>
      <div><b>Warranty &amp; schedule</b><span>{{ pageno('warranty') }}</span></div>
      <div><b>Datasheets</b><span>{% for k, x in pages %}{% if k == 'datasheet' and loop.previtem and loop.previtem[0] != 'datasheet' %}{{ '%02d' % loop.index }}{% endif %}{% endfor %}</span></div>
    </div>

{% elif kind == 'engineering' %}
    {% if co.installed_mwp or co.experience_years %}<p class="lead">With {% if co.installed_mwp %}<span class="hl">over {{ co.installed_mwp }} MWp</span> of PV installations{% endif %}{% if co.installed_mwp and co.experience_years %} and {% endif %}{% if co.experience_years %}engineers with <span class="hl">{{ co.experience_years }}+ years</span> of PV experience{% endif %}, HME designs every system around the client's site, structure and load.</p>{% endif %}
    <img class="layout-img" src="{{ pdir }}/{{ p.images.layout }}" alt="Layout">
    <p class="small muted mt2">{{ p.images.layout_caption }} {{ s.panel.qty }} modules · {{ s.capacity_kwp|num }} kWp DC · {{ s.inverter.qty }} × {{ s.inverter.kva }} kVA inverters. Final layout is confirmed after site survey and detailed engineering.</p>

    <div class="grid g3 mt">
      <div class="xcard">
        <svg viewBox="0 0 24 24" class="ico"><path d="M3 21h18M5 21V9l7-5 7 5v12M9 21v-6h6v6"/></svg>
        <div class="eyebrow">Design excellence</div>
        <p>Layout, string design and cable routing tailored to the roof, shading and load profile, so the system performs reliably for {{ f.years }}+ years.</p>
      </div>
      <div class="xcard">
        <svg viewBox="0 0 24 24" class="ico"><path d="M3 20h18M5 20l3-12h8l3 12M8 8l4 12 4-12M6.5 14h11"/></svg>
        <div class="eyebrow">Structural integrity</div>
        <p>Roof structure is checked by simulation and site assessment before installation, to make sure it carries the PV system safely.</p>
      </div>
      <div class="xcard">
        <svg viewBox="0 0 24 24" class="ico"><path d="M12 3l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.4 6.8 19.1l1-5.8L3.5 9.2l5.9-.9z"/></svg>
        <div class="eyebrow">Tier-1 components only</div>
        <p>{{ s.panel.brand }} modules and {{ s.inverter.brand }} inverters: Tier-1 manufacturers with a proven global track record.</p>
      </div>
    </div>

{% elif kind == 'ongrid' %}
    <p>{{ s.inverter.brand }} smart inverters synchronise with the existing PLN supply. When clouds pass, the grid fills the gap instantly: <b>no switching, no flicker, no interruption</b> to production.</p>
    <div class="grid g2 mt2" style="gap:6mm">
      <div>{{ chart_ongrid[0]|safe }}</div>
      <div>{{ chart_ongrid[1]|safe }}</div>
    </div>
    <div class="legend"><span><i class="ln" style="background:{{ C.amber }}"></i>Solar supply</span><span><i class="ln" style="background:{{ C.grid }}"></i>Power from PLN</span><span><i class="ln dash" style="border-color:{{ C.muted }}"></i>Factory load</span>{% if true %}<span><i class="ln dash" style="border-color:{{ C.amber }}"></i>Clear-sky solar</span>{% else %}<span><i class="ln dash" style="border-color:{{ C.amber }}"></i>Solar not used</span>{% endif %}</div>
    <p class="small muted" style="margin-top:1mm">Illustration based on this project's load and solar size. As solar rises, power drawn from PLN falls by the same amount.</p>

    <div class="mon mt">
      <div class="phone">
        <div class="ph-top"><b>{{ p.client.short_name }}</b><span>{{ s.capacity_kwp|num }} kWp · Today</span></div>
        <div class="ph-ring"><svg viewBox="0 0 36 36"><circle cx="18" cy="18" r="15.9" fill="none" stroke="#E7F0F7" stroke-width="3.2"/><circle cx="18" cy="18" r="15.9" fill="none" stroke="{{ C.amber }}" stroke-width="3.2" stroke-dasharray="{{ mon.share|round(1) }} 100" transform="rotate(-90 18 18)" stroke-linecap="round"/></svg><div><b>{{ mon.share|num }}%</b><span>from solar</span></div></div>
        <div class="ph-grid">
          <div><span>Solar yield</span><b>{{ (mon.yield_kwh/1000)|num(2) }} MWh</b></div>
          <div><span>Consumption</span><b>{{ (mon.cons_kwh/1000)|num(2) }} MWh</b></div>
          <div><span>From grid</span><b>{{ ((mon.cons_kwh - mon.used_kwh)/1000)|num(2) }} MWh</b></div>
          <div><span>CO₂ avoided</span><b>{{ (mon.yield_kwh/1000*f.grid_emission_factor_t_mwh)|num(2) }} t</b></div>
        </div>
        <div class="ph-spark">{{ chart_spark|safe }}</div>
      </div>
      <div class="mon-text">
        <div class="eyebrow">Real-time monitoring</div>
        <h2>See every kWh, live</h2>
        <p>Energy yield, consumption, carbon reduction and alarms are tracked in real time, on the web and on the {{ s.inverter.brand }} mobile app.</p>
        <ul class="checks">
          <li>Live solar output vs. factory consumption</li>
          <li>Daily, monthly and lifetime yield reports</li>
          <li>Instant fault alarms to HME and your team</li>
          <li>Weather station data to verify performance</li>
        </ul>
        <p class="small muted">Illustrative screen with this project's typical-day figures.</p>
      </div>
    </div>

{% elif kind == 'energy' %}
    {% set L = fin.load %}
    <div class="hero">
      <div><div class="cap">Supplied by solar</div><div class="big">{{ (L.solar_share*100)|num }}<small>%</small></div></div>
      <p>Solar will supply about <b>{{ (L.solar_share*100)|num }}% of your electricity</b>, around {{ (L.used_month/1000)|num }} MWh of your {{ (L.monthly_kwh/1000)|num }} MWh monthly consumption{% if has_scr %} ({{ (L.scr*100)|num }}% of solar output is used on site){% endif %}.</p>
    </div>

    <h2 class="mt">Monthly PLN bill</h2>
    {{ chart_bill|safe }}

    {% if chart_days %}
    <h2 class="mt">Working day vs. non-working day</h2>
    <p class="small muted" style="margin-bottom:2mm">{% if has_scr %}When the load is low, solar output above the load (dashed) cannot be used, because surplus export to PLN is not credited.{% endif %}</p>
    <div class="grid {{ 'g2' if chart_days|length > 1 else '' }}" style="gap:6mm">{% for c in chart_days %}<div>{{ c|safe }}</div>{% endfor %}</div>
    <div class="legend"><span><i class="ln" style="background:{{ C.amber }}"></i>Solar supply</span><span><i class="ln" style="background:{{ C.grid }}"></i>Power from PLN</span><span><i class="ln dash" style="border-color:{{ C.muted }}"></i>Factory load</span>{% if false %}<span><i class="ln dash" style="border-color:{{ C.amber }}"></i>Clear-sky solar</span>{% else %}<span><i class="ln dash" style="border-color:{{ C.amber }}"></i>Solar not used</span>{% endif %}</div>
    {% else %}
    <div class="note mt">Your load ({{ L.load_kw|num }} kW) stays above peak solar output ({{ L.pv_peak_kw|num }} kW) all day, so <b>every kWh of solar is used on site</b> and directly replaces power from PLN (see the daily profile on page {{ pageno('ongrid') }}).</div>
    {% endif %}

    <h2 class="mt">Based on your data</h2>
    <table class="kv">
      <tr><td>{% if L.bill_given %}Monthly PLN bill{% else %}Monthly consumption{% endif %}</td><td>{% if L.bill_given %}{{ L.monthly_bill|rp }} ≈ {{ L.monthly_kwh|num }} kWh at Rp {{ f.pln_tariff_rp_kwh|num(2) }}/kWh{% else %}{{ L.monthly_kwh|num }} kWh{% endif %}</td></tr>
      <tr><td>Operating hours</td><td>{% if L.work_hours[0] == 0 and L.work_hours[1] == 24 %}24 hours{% else %}{{ '%02d:00' % L.work_hours[0] }} – {{ '%02d:00' % L.work_hours[1] }}{% endif %} · {{ days_label }}</td></tr>
      {% if not (L.work_hours[0] == 0 and L.work_hours[1] == 24 and L.workdays|length == 7) %}<tr><td>Load outside operating hours</td><td>{{ L.base_pct|num }}% of operating load</td></tr>{% endif %}
      <tr><td>Average load during operation · peak solar output</td><td>{{ L.load_kw|num }} kW · {{ L.pv_peak_kw|num }} kW</td></tr>
    </table>
    <p class="small muted mt2">Estimate: consumption spread evenly over operating hours, typical clear-day solar profile. Actual results vary with weather and load.</p>

{% elif kind == 'roi' %}
    <div class="hero">
      <div><div class="cap">Payback period</div><div class="big">{{ fin.payback|num(1) }}<small>years</small></div></div>
      <p>The system pays for itself in about <b>{{ fin.payback|num(1) }} years</b>. After that, <b>100% of the solar electricity is saving</b> for the remaining {{ (f.years - fin.payback)|num(1) }} years, worth <b>Rp {{ fin.net|short }}</b> net over {{ f.years }} years.</p>
    </div>
    <div class="grid g4 mt">
      <div class="kpi"><div class="v">{{ (fin.capex/1e9)|num(2) }} <small>B</small></div><div class="l">Investment (Rp, excl. VAT)</div></div>
      <div class="kpi"><div class="v">{{ (fin.monthly_saving/1e6)|num(1) }} <small>M/mo</small></div><div class="l">Saving per month, year 1 (Rp)</div></div>
      <div class="kpi"><div class="v">{{ (fin.net/1e9)|num(2) }} <small>B</small></div><div class="l">Net gain after {{ f.years }} years (Rp)</div></div>
      <div class="kpi"><div class="v">{{ fin.roi|num }}<small>%</small></div><div class="l">Return on investment over {{ f.years }} years</div></div>
    </div>

    <div class="steps mt">
      <div class="step"><div class="no">1</div><h3>Produce</h3><div class="f">{{ s.capacity_kwp|num }} kWp × {{ f.peak_sun_hours|num(1) }} h × {{ f.operating_days }} days</div><div class="r">{{ fin.y1_energy|num }} kWh<small>per year{% if has_scr %} · {{ (fin.scr*100)|num }}% used on site{% endif %}</small></div></div>
      <div class="step"><div class="no">2</div><h3>Save</h3><div class="f">{{ fin.y1_used|num }} kWh × Rp {{ f.pln_tariff_rp_kwh|num(2) }}/kWh PLN tariff</div><div class="r">Rp {{ fin.y1_saving|short }}<small>per year</small></div></div>
      <div class="step"><div class="no">3</div><h3>Recover</h3><div class="f">Rp {{ fin.capex|short }} ÷ yearly saving, incl. {{ f.degradation_pct|num(1) }}%/yr degradation</div><div class="r">{{ fin.payback|num(1) }} years<small>to recover the investment</small></div></div>
    </div>

    <h2 class="mt">Cumulative cash position</h2>
    <p class="small muted" style="margin-bottom:1mm">Investment minus all savings to date, at the end of each year. Bars cross zero at break-even.</p>
    {{ chart_cum|safe }}
    <div class="legend"><span><i style="background:{{ C.navy }}"></i>Investment not yet recovered</span><span><i style="background:{{ C.amber }}"></i>Net profit</span><span><i style="border:1.5px dashed {{ C.ink }};background:none"></i>Break-even point</span></div>

{% elif kind == 'savings' %}
    <table class="compact proj">
      <tr><th class="c">Year</th><th class="num">Degr.</th><th class="num">Production (kWh)</th>{% if has_scr %}<th class="num">Used (kWh)</th>{% endif %}<th class="num">Tariff (Rp/kWh)</th><th class="num">Saving (Rp)</th><th class="num">Cumulative (Rp)</th></tr>
      <tr><td class="c">0</td><td></td><td></td>{% if has_scr %}<td></td>{% endif %}<td></td><td class="num muted">Investment</td><td class="num neg">−{{ fin.capex|num }}</td></tr>
      {% for r in fin.rows %}
      <tr{% if r.prev < 0 <= r.cum %} class="be"{% endif %}><td class="c">{{ r.year }}</td><td class="num">{{ r.deg|num(1) }}%</td><td class="num">{{ r.energy|num }}</td>{% if has_scr %}<td class="num">{{ r.used|num }}</td>{% endif %}<td class="num">{{ r.tariff|num(2) }}</td><td class="num">{{ r.saving|num }}</td><td class="num {{ 'neg' if r.cum < 0 else 'pos' }}">{{ '−' if r.cum < 0 }}{{ (r.cum|abs)|num }}</td></tr>
      {% endfor %}
      <tr class="sec"><td class="c">Total</td><td></td><td class="num">{{ fin.total_energy|num }}</td>{% if has_scr %}<td class="num">{{ fin.total_used|num }}</td>{% endif %}<td></td><td class="num">{{ fin.total_saving|num }}</td><td class="num">{{ fin.net|num }}</td></tr>
    </table>
    <p class="small muted mt2">Highlighted: break-even year. Solar electricity costs about <b class="hl">Rp {{ fin.lcoe|num }}/kWh</b> over {{ f.years }} years vs. Rp {{ f.pln_tariff_rp_kwh|num }}/kWh from PLN.</p>

    <div class="grid g2 mt" style="grid-template-columns: 1.3fr 1fr; gap:6mm">
      <div>
        <h3>Assumptions</h3>
        <table class="kv compact">
          <tr><td>PLN tariff</td><td>Rp {{ f.pln_tariff_rp_kwh|num(2) }}/kWh{% if f.tariff_note %}<br><span class="muted" style="font-weight:400">{{ f.tariff_note }}</span>{% endif %}</td></tr>
          <tr><td>Sun hours · days</td><td>{{ f.peak_sun_hours|num(1) }} h/day · {{ f.operating_days }} days/yr</td></tr>
          <tr><td>Degradation</td><td>{{ f.degradation_first_year_pct|num(1) }}% yr 1, then {{ f.degradation_pct|num(1) }}%/yr</td></tr>
          <tr><td>Solar used on site</td><td>{{ (fin.scr*100)|num }}% · no export credit</td></tr>
          <tr><td>O&amp;M cost</td><td>{% if f.om_pct_of_capex %}{{ f.om_pct_of_capex|num(1) }}% of investment/yr{% else %}Not included{% endif %}</td></tr>
        </table>
      </div>
      <div>
        <h3>If PLN tariffs rise</h3>
        <table class="compact">
          <tr><th>Increase</th><th class="num">Payback</th><th class="num">Net gain</th></tr>
          {% for r in fin.sens %}
          <tr{% if r.current %} class="be"{% endif %}><td>{{ r.esc }}%/yr{% if r.current %} · base{% endif %}</td><td class="num">{{ r.payback|num(1) }} yrs</td><td class="num">Rp {{ r.net|short }}</td></tr>
          {% endfor %}
        </table>
      </div>
    </div>

{% elif kind == 'quotation' %}
    <table class="price">
      <tr><th>Description</th><th class="num">Price (Rp)</th></tr>
      {% set it = p.price["items"] %}<tr><td><b>{{ it[0] }}</b>{% for x in it[1:] %}<small>Includes {{ x|lower }}</small>{% endfor %}</td><td class="num">{{ fin.capex|num }}</td></tr>
      <tr class="total"><td>Total (excl. VAT)</td><td class="num">{{ fin.capex|num }}</td></tr>
      <tr><td>VAT {{ p.price.vat_pct }}%</td><td class="num">{{ fin.vat|num }}</td></tr>
      <tr class="grand"><td>Grand total</td><td class="num">{{ fin.grand|num }}</td></tr>
    </table>
    <p class="small muted mt2">Lump-sum EPC price for the complete system as listed in the Bill of Quantity. Equivalent to Rp {{ fin.price_per_wp|num }} per Wp (excl. VAT).</p>

    <h2 class="mt">Terms and conditions</h2>
    <ul class="terms">{% for t in p.terms %}<li>{{ t }}</li>{% endfor %}</ul>

    <h2 class="mt">Approval</h2>
    <div class="sign">
      <div><span>Approved by</span><b>{{ p.client.name }}</b></div>
      <div><span>Proposed by</span><b>PT Hexa Multi Energi · {{ p.meta.prepared_by }}</b></div>
    </div>

{% elif kind == 'scope' %}
    <p>HME provides a complete engineering, procurement and construction service. Responsibilities are split as follows.</p>
    <div class="grid g2 mt2" style="grid-template-columns: 1.25fr 1fr; gap: 6mm">
      <table>
        <tr><th>Documentation &amp; services</th><th class="c">HME</th><th class="c">Client</th></tr>
        {% for no, item, hme, cl in p.scope.services %}
        <tr{% if '.' not in no %} style="font-weight:600"{% endif %}><td>{% if '.' in no %}<span class="muted" style="display:inline-block;width:8mm;padding-left:2mm">{{ no }}</span>{% else %}<span style="display:inline-block;width:8mm">{{ no }}</span>{% endif %}{{ item }}</td><td class="c">{% if hme %}<i class="tick"></i>{% endif %}</td><td class="c">{% if cl %}<i class="tick"></i>{% endif %}</td></tr>
        {% endfor %}
      </table>
      <table>
        <tr><th>Products of supply</th><th class="c">HME</th></tr>
        {% for item in p.scope.supply %}<tr><td><span class="muted" style="display:inline-block;width:7mm">{{ loop.index }}</span>{{ item }}</td><td class="c"><i class="tick"></i></td></tr>{% endfor %}
      </table>
    </div>

{% elif kind == 'boq' %}
    <table class="compact">
      <tr><th style="width:9mm">No</th><th>Item</th><th class="num" style="width:20mm">Qty</th><th style="width:13mm">Unit</th><th>Specification</th></tr>
      {% for sec in d.sections %}
      <tr class="sec"><td colspan="5">{{ sec.section }}</td></tr>
      {% for no, item, qty, unit, spec in sec["items"] %}
      <tr><td class="muted">{{ no }}</td><td>{{ item }}</td><td class="num">{{ qty|num }}</td><td>{{ unit }}</td><td class="muted">{{ spec }}</td></tr>
      {% endfor %}
      {% endfor %}
    </table>
    {% if loop.nextitem and loop.nextitem[0] != 'boq' %}<p class="small muted mt2">All items are included in the lump-sum price. A detailed price breakdown is available on request.</p>{% endif %}

{% elif kind == 'warranty' %}
    <div class="grid g4">
      {% for w in p.warranty %}<div class="wcard"><div class="eyebrow">{{ w.item }}</div><div class="v">{{ w.value }}</div><div class="d">{{ w.detail }}</div></div>{% endfor %}
    </div>
    <h2 class="mt" style="margin-top:10mm">Preliminary schedule</h2>
    <p class="small muted">Indicative timeline from signing of the EPC agreement. Final schedule is agreed at kick-off.</p>
    {{ chart_sched|safe }}
    <div class="note mt">After commissioning, HME provides operator training, handover documents (as-built drawings, test reports, manuals) and online monitoring access.</div>

{% elif kind == 'datasheet' %}
    <div class="ds-slot"></div>
{% endif %}

  </main>
  <footer class="pf"><span><b>PT Hexa Multi Energi</b> · {{ p.meta.number }} · {{ p.client.short_name }}</span><span>www.hexamultienergi.com · admin@hexamultienergi.com</span><span class="pg">{{ '%02d' % n }} / {{ '%02d' % total_pages }}</span></footer>
</section>
{% endif %}
{% endfor %}
</body>
</html>
