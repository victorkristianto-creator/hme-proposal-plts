# Repo publik: hanya generator, skill, contoh anonim, dan datasheet PDF.
# Proyek klien, output PDF, dan file kerja lain TIDAK PERNAH masuk repo.
/*
!/.gitignore
!/README.md
!/requirements.txt

!/.claude/
/.claude/*
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/buat-proposal-cni/
!/.claude/skills/buat-proposal-developer/

!/proposal-generator/
/proposal-generator/output/
/proposal-generator/backup/
/proposal-generator/.claude/
/proposal-generator/.impeccable/
/proposal-generator/PLAN-redesign-v2.md
/proposal-generator/projects/*
!/proposal-generator/projects/_base/
!/proposal-generator/projects/contoh-*/
/proposal-generator/projects/contoh-*/project.json
/proposal-generator/projects/contoh-*/img/

!/datasheet/
/datasheet/**
!/datasheet/**/
!/datasheet/**/*.pdf
/datasheet/*.pdf
/datasheet/**/*Pricebook*
/datasheet/**/*Manual*
/datasheet/**/Promotion*
/datasheet/**/*_cropped.pdf
/datasheet/**/*(1)*

__pycache__/
*.pyc
